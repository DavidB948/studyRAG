# Copy to .env and fill in. Only secrets and per-machine values live here — model
# choices, chunk sizes and the embedding dimension are design decisions and live in
# studyrag/config.py, where they stay in version control alongside the schema.

# Supabase → Project Settings → Database → Connection string (URI, "Session pooler")
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Generation. Any OpenAI-compatible endpoint; the client never learns which vendor.
#   DeepSeek  https://api.deepseek.com                              deepseek-chat
#   Gemini    https://generativelanguage.googleapis.com/v1beta/openai/  gemini-3.6-flash
#   Ollama    http://localhost:11434/v1  (any dummy key)            llama3
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ragas judge. Separate on purpose: it makes ~20x the calls of generation (each answer
# is decomposed into statements and verified one at a time), so it hits different rate
# limits and is often worth pointing at another vendor. Keeping it separate also means
# a judge upgrade never silently changes what the system under test produces.
# Falls back to the LLM_* values above when unset.
#
# Note: a free tier capped at 20 requests/day cannot run this eval at all.
JUDGE_BASE_URL=https://api.deepseek.com
JUDGE_API_KEY=
JUDGE_MODEL=deepseek-chat
